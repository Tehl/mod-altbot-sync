[worldserver]

########################################
# mod-altbot-sync configuration
########################################

#
#    AltbotSync.Debug
#        Description: Enables debug logging for the module.
#        Default:     0 (disabled)
#                     Valid values: 0 (off) / 1 (on)
AltbotSync.Debug = 0

#
#    AltbotSync.CatchUp.Triggers.OnGroupJoin
#        Description: Automatically trigger catch up for altbots when they join the group.
#                     This will sync level / skills and quest completion.
#        Default:     0 (disabled)
#                     Valid values: 0 (off) / 1 (on)
AltbotSync.CatchUp.Triggers.OnGroupJoin = 0

#
#    AltbotSync.CatchUp.Triggers.OnLevelUp
#        Description: Automatically trigger catch up for altbots when the player levels up.
#                     This will sync level / skills but not quest completion.
#        Default:     0 (disabled)
#                     Valid values: 0 (off) / 1 (on)
AltbotSync.CatchUp.Triggers.OnLevelUp = 0

#
#    AltbotSync.CatchUp.Triggers.OnQuestComplete
#        Description: Automatically trigger catch up for altbots when the player completes a quest.
#                     This will sync quest completion but not level / skills.
#        Default:     0 (disabled)
#                     Valid values: 0 (off) / 1 (on)
AltbotSync.CatchUp.Triggers.OnQuestComplete = 0

#
#    AltbotSync.CatchUp.Quests.IgnoreClassQuests
#        Description: List of class quests which will not be automatically completed when catching up an altbot.
#        Format:      <questId>,<questId>,<questId>
#        Default:     See docs/ignored-quests.md
